# Copy to .env and fill in values.

# --- Local dev (SQLite) ---
DATABASE_URL=sqlite+aiosqlite:///./healthcare.db

# --- Staging / Production (PostgreSQL) ---
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/healthcare

# --- Auth ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- MFA (TOTP) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MFA_ENCRYPTION_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
